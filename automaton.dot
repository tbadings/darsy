digraph MONA_DFA {
 rankdir = LR;
 center = true;
 size = "7.5,10.5";
 edge [fontname = Courier];
 node [height = .5, width = .5];
 node [shape = doublecircle]; 4;
 node [shape = circle]; 1;
 init [shape = plaintext, label = ""];
 init -> 1;
 1 -> 1 [label="~goal & ~unsafe & (carpet | ~wet)"];
 1 -> 2 [label="wet & ~carpet & ~goal & ~unsafe"];
 1 -> 3 [label="unsafe | (goal & wet & ~carpet)"];
 1 -> 4 [label="goal & ~unsafe & (carpet | ~wet)"];
 2 -> 2 [label="~carpet & ~goal & ~unsafe"];
 2 -> 1 [label="carpet & ~goal & ~unsafe"];
 2 -> 3 [label="unsafe | (goal & ~carpet)"];
 2 -> 4 [label="carpet & goal & ~unsafe"];
 3 -> 3 [label="true"];
 4 -> 4 [label="~unsafe & (carpet | ~wet)"];
 4 -> 5 [label="wet & ~carpet & ~goal & ~unsafe"];
 4 -> 3 [label="unsafe | (goal & wet & ~carpet)"];
 5 -> 5 [label="~carpet & ~goal & ~unsafe"];
 5 -> 4 [label="carpet & ~unsafe"];
 5 -> 3 [label="unsafe | (goal & ~carpet)"];
}